{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hbi.local/schemas/hair-color-contract-v1.schema.json",
  "title": "HBI Hair Color Synthetic Contract",
  "description": "Structural schema for the synthetic-only S01-S15 contract bundle. It does not validate product behavior or scientific evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "data_classification",
    "scientific_evidence",
    "runtime_execution",
    "fixtures"
  ],
  "properties": {
    "contract_version": {
      "const": "HBI-HC-TEST-CONTRACT-1.0"
    },
    "data_classification": {
      "const": "SYNTHETIC_ONLY"
    },
    "scientific_evidence": {
      "const": false
    },
    "runtime_execution": {
      "const": false
    },
    "fixtures": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "scenario_id",
          "synthetic",
          "input_profile",
          "expected_status",
          "expected_action",
          "required_evidence",
          "forbidden",
          "assertions",
          "severity_on_violation"
        ],
        "properties": {
          "fixture_id": {
            "type": "string",
            "pattern": "^FX-S(0[1-9]|1[0-5])-SYN-01$"
          },
          "scenario_id": {
            "type": "string",
            "pattern": "^S(0[1-9]|1[0-5])$"
          },
          "synthetic": {
            "const": true
          },
          "input_profile": {
            "type": "string",
            "minLength": 1
          },
          "expected_status": {
            "type": "string",
            "minLength": 1
          },
          "expected_action": {
            "type": "string",
            "minLength": 1
          },
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbidden": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "severity_on_violation": {
            "enum": [
              "C0",
              "C1"
            ]
          },
          "wire_mapping_boundary": {
            "const": "UNRESOLVED_NOT_ASSERTED"
          },
          "traceability_oracle": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "scenario",
              "case_lineage",
              "target_lineage",
              "evaluation_run_refs",
              "suggestion_refs",
              "ledger_snapshots",
              "dependency_outcomes",
              "decision_transfer"
            ],
            "properties": {
              "scope": {
                "const": "TEST_ORACLE_ONLY_NOT_WIRE_CONTRACT"
              },
              "scenario": {
                "enum": [
                  "S11",
                  "S12",
                  "S13"
                ]
              },
              "case_lineage": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "role",
                    "ref",
                    "version_ref"
                  ],
                  "properties": {
                    "role": {
                      "enum": [
                        "CASE",
                        "TARGET"
                      ]
                    },
                    "ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version_ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "target_lineage": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "role",
                    "ref",
                    "version_ref"
                  ],
                  "properties": {
                    "role": {
                      "enum": [
                        "CASE",
                        "TARGET"
                      ]
                    },
                    "ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version_ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "evaluation_run_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "suggestion_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ref",
                    "version_ref",
                    "evaluation_run_ref"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version_ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evaluation_run_ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "ledger_snapshots": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "phase",
                    "acceptance",
                    "execution_consent",
                    "active_suggestion_version_refs",
                    "rejected_suggestion_version_refs"
                  ],
                  "properties": {
                    "phase": {
                      "enum": [
                        "BEFORE_QUESTION",
                        "AFTER_QUESTION",
                        "BEFORE_REJECTION",
                        "AFTER_REJECTION",
                        "PRIOR_VERSION_HISTORY",
                        "NEW_VERSION_DEFAULT"
                      ]
                    },
                    "acceptance": {
                      "enum": [
                        "PENDING",
                        "ACCEPTED",
                        "REJECTED",
                        "NOT_APPLICABLE"
                      ]
                    },
                    "execution_consent": {
                      "enum": [
                        "NOT_GRANTED",
                        "GRANTED",
                        "NOT_APPLICABLE"
                      ]
                    },
                    "active_suggestion_version_refs": {
                      "type": "array",
                      "minItems": 0,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "rejected_suggestion_version_refs": {
                      "type": "array",
                      "minItems": 0,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "dependency_outcomes": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "output_ref",
                    "dependency_class",
                    "expected_treatment"
                  ],
                  "properties": {
                    "output_ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "dependency_class": {
                      "enum": [
                        "DEPENDENT",
                        "INDEPENDENT"
                      ]
                    },
                    "expected_treatment": {
                      "enum": [
                        "REEVALUATE",
                        "PRESERVE"
                      ]
                    }
                  }
                }
              },
              "decision_transfer": {
                "enum": [
                  "NOT_APPLICABLE",
                  "NOT_CARRIED_FORWARD"
                ]
              }
            }
          }
        }
      }
    }
  }
}
