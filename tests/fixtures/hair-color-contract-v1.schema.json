{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hbi.local/schemas/hair-color-contract-v1.schema.json",
  "title": "HBI Hair Color Synthetic Contract",
  "description": "Structural schema for the synthetic-only S01-S15 contract bundle. It does not validate product behavior or scientific evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "data_classification",
    "scientific_evidence",
    "runtime_execution",
    "fixtures"
  ],
  "properties": {
    "contract_version": {
      "const": "HBI-HC-TEST-CONTRACT-1.0"
    },
    "data_classification": {
      "const": "SYNTHETIC_ONLY"
    },
    "scientific_evidence": {
      "const": false
    },
    "runtime_execution": {
      "const": false
    },
    "fixtures": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "scenario_id",
          "synthetic",
          "input_profile",
          "expected_status",
          "expected_action",
          "required_evidence",
          "forbidden",
          "assertions",
          "severity_on_violation"
        ],
        "properties": {
          "fixture_id": {
            "type": "string",
            "pattern": "^FX-S(0[1-9]|1[0-5])-SYN-01$"
          },
          "scenario_id": {
            "type": "string",
            "pattern": "^S(0[1-9]|1[0-5])$"
          },
          "synthetic": {
            "const": true
          },
          "input_profile": {
            "type": "string",
            "minLength": 1
          },
          "expected_status": {
            "type": "string",
            "minLength": 1
          },
          "expected_action": {
            "type": "string",
            "minLength": 1
          },
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbidden": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "severity_on_violation": {
            "enum": [
              "C0",
              "C1"
            ]
          }
        }
      }
    }
  }
}
