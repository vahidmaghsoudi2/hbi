# ═══════════════════════════════════════════════════════
# HBI Project — .gitignore
# Phase 3 — GIT-01 Cleanup
# ═══════════════════════════════════════════════════════

# ─── Database Files (CRITICAL: Never commit) ──────────
*.db
*.sqlite
*.sqlite3
data/
test.db

# ─── Backup Files ─────────────────────────────────────
*.bak
*.backup
backups/

# ─── Python Cache ─────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ─── Virtual Environments ─────────────────────────────
venv/
env/
ENV/
.venv/

# ─── IDE & Editor Files ───────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS Files ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs ─────────────────────────────────────────────
*.log
migration.log

# ─── Temporary Files ──────────────────────────────────
*.tmp
*.temp
*.zip
hbi_security_audit.zip
_security_audit_temp/

# ─── Environment Variables ────────────────────────────
.env
.env.local
.env.production

# ─── Test Artifacts ───────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ─── Build Artifacts ──────────────────────────────────
build/
dist/
*.egg-info/

# Test and temporary files (added by Qwen)
github_handshake*.py
github_report*.py
github_report*.json
test_github*.ps1
test_token*.py
*.log
