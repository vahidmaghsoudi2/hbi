# --- HBI Project .gitignore ---

# Database (runtime artifact)
data/*.db
data/*.sqlite
data/*.sqlite3

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
env/
venv/
.venv/

# pytest cache
.pytest_cache/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary setup scripts
setup_git*.bat
hbi_setup_memory.py
create_reference_docs.py

# Stray files
cd
python
type

# Added by cleanup
*.pyc
*.bak
