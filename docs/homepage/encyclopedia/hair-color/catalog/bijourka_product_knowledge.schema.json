{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hbi.example/schemas/bijourka-product-knowledge-v1.json",
  "title": "HBI Bijourka Product Knowledge Record",
  "description": "Evidence-linked, product-specific knowledge records for Bijourka. Catalog identity is referenced exactly; chemical, safety, compatibility and outcome claims require product-specific evidence and specialist review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_reference",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "hbi.bijourka-product-knowledge.v1"
    },
    "catalog_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "identity_scope",
        "snapshot_id",
        "content_sha256"
      ],
      "properties": {
        "authority": {
          "const": "PRODUCT_OWNER_APPROVED"
        },
        "identity_scope": {
          "const": "BIJOURKA_SHADE_IDENTITY_ONLY"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/productRecord"
      }
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "productRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "catalog_identity",
        "product_context",
        "formulation",
        "claims",
        "evidence",
        "expert_review",
        "evidence_gaps",
        "record_status"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^BIJOURKA-KNOWLEDGE-[A-Z0-9-]+$"
        },
        "catalog_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "brand",
            "series",
            "shade_number",
            "shade_name"
          ],
          "properties": {
            "brand": {
              "type": "string",
              "minLength": 1
            },
            "series": {
              "type": "string",
              "minLength": 1
            },
            "shade_number": {
              "type": "string",
              "minLength": 1
            },
            "shade_name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "product_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "market_region",
            "product_variant",
            "package_identifier",
            "gtin",
            "lot",
            "formula_version"
          ],
          "properties": {
            "market_region": {
              "$ref": "#/$defs/nullableString"
            },
            "product_variant": {
              "$ref": "#/$defs/nullableString"
            },
            "package_identifier": {
              "$ref": "#/$defs/nullableString"
            },
            "gtin": {
              "$ref": "#/$defs/nullableString"
            },
            "lot": {
              "$ref": "#/$defs/nullableString"
            },
            "formula_version": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "formulation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "ingredient_list",
            "notes"
          ],
          "properties": {
            "status": {
              "enum": [
                "UNKNOWN",
                "PARTIAL",
                "COMPLETE",
                "CONFLICT"
              ]
            },
            "ingredient_list": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "inci_name",
                  "declared_order",
                  "evidence_ids"
                ],
                "properties": {
                  "inci_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "declared_order": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "concentration_value": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "concentration_unit": {
                    "$ref": "#/$defs/nullableString"
                  },
                  "evidence_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_id",
              "claim_type",
              "claim_scope",
              "statement",
              "evidence_status",
              "evidence_ids",
              "limitations"
            ],
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "claim_type": {
                "enum": [
                  "IDENTITY_FACT",
                  "MANUFACTURER_CLAIM",
                  "EVIDENCE_SUPPORTED_CLAIM",
                  "SPECIALIST_ASSESSMENT",
                  "INFERENCE",
                  "UNKNOWN",
                  "CONFLICT"
                ]
              },
              "claim_scope": {
                "enum": [
                  "IDENTITY",
                  "COMPOSITION",
                  "USAGE",
                  "PERFORMANCE",
                  "SAFETY",
                  "COMPATIBILITY",
                  "COLOR_OUTCOME"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "evidence_status": {
                "enum": [
                  "UNVERIFIED",
                  "SUPPORTED_WITHIN_SCOPE",
                  "CONFLICTING",
                  "UNKNOWN"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "source_type",
              "source_reference",
              "captured_at",
              "applies_to",
              "description"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "source_type": {
                "enum": [
                  "MANUFACTURER_DOCUMENT",
                  "PACKAGE_LABEL",
                  "REGULATORY_DOCUMENT",
                  "SCIENTIFIC_PUBLICATION",
                  "SPECIALIST_REVIEW",
                  "LAB_REPORT",
                  "OTHER"
                ]
              },
              "source_reference": {
                "type": "string",
                "minLength": 1
              },
              "captured_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "applies_to": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "market_region",
                  "product_variant",
                  "lot",
                  "formula_version"
                ],
                "properties": {
                  "market_region": {
                    "$ref": "#/$defs/nullableString"
                  },
                  "product_variant": {
                    "$ref": "#/$defs/nullableString"
                  },
                  "lot": {
                    "$ref": "#/$defs/nullableString"
                  },
                  "formula_version": {
                    "$ref": "#/$defs/nullableString"
                  }
                }
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "content_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            }
          }
        },
        "expert_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "scope",
            "reviewed_claim_ids",
            "reviewed_at",
            "limitations"
          ],
          "properties": {
            "status": {
              "enum": [
                "NOT_REVIEWED",
                "PENDING",
                "ACCEPTED",
                "REJECTED",
                "LIMITED"
              ]
            },
            "scope": {
              "type": "array",
              "items": {
                "enum": [
                  "COMPOSITION",
                  "USAGE",
                  "PERFORMANCE",
                  "SAFETY",
                  "COMPATIBILITY",
                  "COLOR_OUTCOME"
                ]
              }
            },
            "reviewed_claim_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reviewed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "evidence_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gap_type",
              "field",
              "description",
              "blocks"
            ],
            "properties": {
              "gap_type": {
                "enum": [
                  "DATA_GAP",
                  "KNOWLEDGE_GAP",
                  "SOURCE_CONFLICT",
                  "EXPERT_REVIEW_REQUIRED"
                ]
              },
              "field": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "blocks": {
                "type": "array",
                "items": {
                  "enum": [
                    "CHEMICAL_GUIDANCE",
                    "SAFETY_ASSESSMENT",
                    "COMPATIBILITY_ASSESSMENT",
                    "FORMULA_SELECTION",
                    "PROCESSING_PARAMETERS",
                    "COLOR_OUTCOME_PREDICTION"
                  ]
                }
              }
            }
          }
        },
        "record_status": {
          "enum": [
            "DRAFT",
            "REVIEW_PENDING",
            "REVIEWED_LIMITED",
            "APPROVED_FOR_DEFINED_SCOPE",
            "WITHHELD"
          ]
        }
      }
    }
  }
}
