/* ============================================================
   Desk / POS feel — sales + dashboard pulse (scoped)
   ============================================================ */

.pro-desk {
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
}

.pro-desk-hero {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.1rem 1.25rem;
  border-radius: 16px;
  background: linear-gradient(145deg, #f7faf5 0%, #eef3ea 55%, #f4efe6 100%);
  border: 1px solid var(--line);
}

.pro-desk-hero-label {
  margin: 0;
  font-size: 0.85rem;
  color: var(--muted);
  font-weight: 600;
}

.pro-desk-total {
  margin: 0.15rem 0 0;
  font-size: clamp(1.75rem, 4vw, 2.35rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--brand-2);
  line-height: 1.15;
}

.pro-desk-meta {
  margin: 0.35rem 0 0;
  font-size: 0.88rem;
  color: var(--muted);
}

.pro-desk-submit {
  min-width: 10rem;
  padding: 0.85rem 1.4rem !important;
  font-size: 1.05rem !important;
  font-weight: 700 !important;
  border-radius: 12px !important;
  box-shadow: 0 8px 20px rgba(61, 82, 53, 0.22);
}

.pro-desk-submit:disabled {
  box-shadow: none;
}

.pro-party-strip {
  padding: 0.85rem 1rem;
  border-radius: 12px;
  background: #faf8f4;
  border: 1px dashed var(--line);
}

.pro-party-strip .pro-label {
  margin-bottom: 0.35rem;
}

.pro-party-connected {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.65rem 1rem;
}

.pro-party-connected strong {
  font-size: 1.02rem;
}

.pro-last-sale {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  padding: 0.9rem 1.1rem;
  border-radius: 14px;
  background: var(--soft);
  border: 1px solid #cfdcc8;
}

.pro-last-sale-mark {
  width: 2.2rem;
  height: 2.2rem;
  border-radius: 999px;
  background: var(--brand);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  flex-shrink: 0;
}

.pro-dash-hero {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 0.85rem;
  margin-bottom: 1.25rem;
}

@media (max-width: 720px) {
  .pro-dash-hero {
    grid-template-columns: 1fr;
  }
}

.pro-dash-hero-main {
  padding: 1.25rem 1.35rem;
  border-radius: 16px;
  background: linear-gradient(155deg, #4f6744 0%, #3d5235 100%);
  color: #f7faf5;
  border: none;
  box-shadow: 0 12px 28px rgba(61, 82, 53, 0.28);
}

.pro-dash-hero-main h2 {
  margin: 0;
  font-size: 0.92rem;
  font-weight: 600;
  opacity: 0.9;
}

.pro-dash-hero-main .pro-metric {
  margin: 0.35rem 0 0.15rem;
  font-size: clamp(1.8rem, 4vw, 2.4rem);
  font-weight: 800;
  letter-spacing: -0.02em;
}

.pro-dash-hero-main .pro-muted {
  color: rgba(247, 250, 245, 0.82);
}

.pro-dash-hero-main a.pro-btn-secondary {
  margin-top: 0.75rem;
  display: inline-flex;
  background: rgba(255, 255, 255, 0.14);
  border-color: rgba(255, 255, 255, 0.28);
  color: #fff;
}

.pro-dash-hero-main a.pro-btn-secondary:hover {
  background: rgba(255, 255, 255, 0.22);
}

.pro-dash-hero-side {
  padding: 1.15rem 1.25rem;
  border-radius: 16px;
  background: var(--warn-bg);
  border: 1px solid #e5cfcf;
}

.pro-dash-hero-side h2 {
  margin: 0;
  font-size: 0.92rem;
  color: var(--warn);
}

.pro-dash-hero-side .pro-metric {
  margin: 0.3rem 0;
  font-size: 1.65rem;
  font-weight: 800;
  color: var(--warn);
}

.pro-action-card--sale {
  border-color: #c5d4be;
  background: linear-gradient(180deg, #ffffff 0%, #f3f7f1 100%);
  box-shadow: 0 8px 22px rgba(61, 82, 53, 0.08);
}

.pro-action-card--sale h3 {
  color: var(--brand-2);
}

.pro-section-kicker {
  margin: 0 0 0.35rem;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--accent);
  text-transform: none;
}
